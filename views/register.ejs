<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register | MimiBooks</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include("partials/header") %>
    <main class="auth-wrap">
        <section class="auth-card">
            <p class="eyebrow">JOIN OUR READING COMMUNITY</p>
            <h1>Create an account</h1>
            <p>Register with MimiBooks to get started.</p>
            <% if (error) { %><div class="alert"><%= error %></div><% } %>
            <form action="/register" method="POST" class="form-stack">
                <label>Full name<input type="text" name="name" required></label>
                <label>Email address<input type="email" name="email" required></label>
                <label>Phone number<input type="tel" name="phone"></label>
                <label>Password (minimum 8 characters)<input type="password" name="password" minlength="8" required></label>
                <label>Confirm password<input type="password" name="confirmPassword" minlength="8" required></label>
                <button class="btn full-btn" type="submit">Create account</button>
            </form>
            <p class="form-note">Already registered? <a href="/login">Login here</a></p>
        </section>
    </main>
    <%- include("partials/footer") %>
</body>
</html>
