<header class="site-header">
    <a class="brand" href="/">Mimi<span>Books</span></a>
    <nav>
        <a href="/">Home</a>
        <a href="/books">Catalogue</a>
        <a href="/cart">Cart (<%= cartCount %>)</a>
        <% if (currentUser) { %>
            <span class="welcome">Hi, <%= currentUser.name %></span>
            <form action="/logout" method="POST" class="inline-form">
                <button class="nav-button" type="submit">Logout</button>
            </form>
        <% } else { %>
            <a href="/login">Login</a>
            <a class="nav-register" href="/register">Register</a>
        <% } %>
    </nav>
</header>
